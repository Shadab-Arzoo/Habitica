<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:name=".RoutineFlowApplication"
        android:allowBackup="true"
        android:label="RoutineFlow"
        android:supportsRtl="true"
        android:theme="@style/Theme.RoutineFlow">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".widgets.RoutineFlowWidget"
            android:exported="false"
            android:label="RoutineFlow">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/routineflow_widget_info" />
        </receiver>
        <receiver
            android:name=".widgets.RoutineFlowWeekWidget"
            android:exported="false"
            android:label="RoutineFlow Week">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/routineflow_week_widget_info" />
        </receiver>
        <receiver
            android:name=".notifications.ReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".notifications.ReminderBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
